# Production environment checklist. Keep real values in the hosting provider's
# secret store; do not commit a populated .env.production file.
APP_ENV=production

# Required app settings
DATABASE_URL=
DATABASE_URL_UNPOOLED=
SECRET_KEY=
VLLM_BASE_URL=
VLLM_API_KEY=
VLLM_MODEL=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=truhire_candidate_vectors

# Required lexical search service
OPENSEARCH_URL=
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=truhire_candidates_v2

# Optional managed Redis. Set both URLs when cache and ingestion queue need isolation.
REDIS_URL=
CACHE_REDIS_URL=
QUEUE_REDIS_URL=
USE_ARQ_QUEUE=false

# Neon resume storage
OBJECT_STORAGE_BACKEND=neon
OBJECT_STORAGE_BUCKET=resumes
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2

# Runtime defaults
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
LAYA_ENABLED=false
UVICORN_WORKERS=1
CORS_ORIGINS=["https://your-frontend.onrender.com"]

# Set this in the frontend hosting/build environment when frontend and API are
# separate origins. Leave unset when Nginx serves the frontend and proxies /api.
VITE_API_BASE_URL=https://your-api.onrender.com
