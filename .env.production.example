# Production-like local settings template. Copy to .env.production and replace
# every blank value with fresh credentials. Render should use Dashboard env vars.
APP_ENV=production

# Required app settings
DATABASE_URL=
DATABASE_URL_UNPOOLED=
SECRET_KEY=
VLLM_BASE_URL=
VLLM_API_KEY=
VLLM_MODEL=
QDRANT_URL=
QDRANT_API_KEY=

# Neon resume storage
OBJECT_STORAGE_BACKEND=neon
OBJECT_STORAGE_BUCKET=resumes
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2

# Runtime defaults
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
LAYA_ENABLED=false
UVICORN_WORKERS=1
CORS_ORIGINS=["https://your-frontend.onrender.com"]
